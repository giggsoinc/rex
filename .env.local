# Rex — Local Development Configuration
# Copy to .env and customize as needed

# LLM Provider
REX_LLM_PROVIDER=ollama
REX_LLM_ENDPOINT=http://localhost:11434
REX_LLM_MODEL=dolphin-mistral:latest
REX_EMBED_MODEL=all-minilm:latest
REX_PROFILE=full

# Vision (Gemini Flash)
REX_VISION_PROVIDER=gemini
REX_VISION_MODEL=gemini-2.0-flash
REX_GEMINI_API_KEY=

# Database
REX_DB_URL=postgresql+asyncpg://rex:rex@localhost:5432/rex

# Storage
REX_STORAGE_BACKEND=local
REX_STORAGE_PATH=./output

# Processing
REX_MAX_TEXT_CHARS=2000
REX_DEDUP_NEAR_THRESHOLD=0.92
REX_DEDUP_RELATED_THRESHOLD=0.80
REX_BATCH_SIZE=10
REX_OLLAMA_PARALLEL=4

# Logging
REX_LOG_LEVEL=INFO
REX_LOG_FORMAT=pretty
